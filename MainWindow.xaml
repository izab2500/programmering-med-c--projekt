<Window x:Class="quasi_route.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:quasi_route"
        mc:Ignorable="d"
        Title="Kvasirutt"
        Height="1024"
        Width="1560"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Background="White">

            <!-- MAIN LAYOUT -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                    Background="#E5E5E5">

                <TextBlock Text="Kvasirutt"
                           FontSize="26"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </Border>


            <!-- MAIN -->
            <Grid Grid.Row="1"
                  Margin="40,40,40,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- MAP SECTION -->
                <Border Grid.Column="0"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        Background="#F8F8F8">

                    <Grid>

                        <TextBlock Text="Karta"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Margin="24"/>

                        <!-- MAP -->
                     <Viewbox MaxWidth="560"
                             MaxHeight="560"
                             HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stretch="Uniform">

                    <Border Width="560"
                            Height="560"
                            BorderBrush="#BDBDBD"
                            BorderThickness="1"
                            Background="White">

                    <UniformGrid x:Name="MapGrid"/>
                </Border>
            </Viewbox>

                    </Grid>
                </Border>


                <!-- CONTROL PANEL -->
                <Border Grid.Column="2"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        Background="#F8F8F8">

                    <Grid Margin="20,20">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <!-- TITLE -->
                        <TextBlock Grid.Row="0"
                                   Text="Kontrollpanel"
                                   FontSize="24"
                                   FontWeight="SemiBold"/>

                        <!-- MAP SIZE -->
                        <Border Grid.Row="2"
                                Height="60"
                                HorizontalAlignment="Stretch"
                                BorderBrush="#C8C8C8"
                                BorderThickness="1"
                                Background="White"
                                CornerRadius="6">

                            <Grid Margin="16,0">

                                <TextBlock Text="Kartstorlek"
                                           VerticalAlignment="Center"
                                           FontSize="14"/>

                                <ComboBox HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Width="110"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          FontSize="14"
                                          SelectedIndex="0"
                                          x:Name="MapSizeComboBox">

                                    <ComboBoxItem Content="20 × 20"/>
                                    <ComboBoxItem Content="30 × 30"/>
                                    <ComboBoxItem Content="40 × 40"/>

                                </ComboBox>

                            </Grid>
                        </Border>

                        <!-- ALGORITHM -->
                        <Border Grid.Row="4"
                                Height="60"
                                HorizontalAlignment="Stretch"
                                BorderBrush="#C8C8C8"
                                BorderThickness="1"
                                Background="White"
                                CornerRadius="6">

                            <Grid Margin="16,0">

                                <TextBlock Text="Algoritm"
                                           VerticalAlignment="Center"
                                           FontSize="14"/>

                                <ComboBox HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Width="110"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          FontSize="14"
                                          SelectedIndex="0"
                                          x:Name="AlgorithmComboBox">

                                    <ComboBoxItem Content="BFS"/>
                                    <ComboBoxItem Content="Dijkstra"/>

                                </ComboBox>

                            </Grid>
                        </Border>


                        <!-- CREATE MAP -->
                        <Button Grid.Row="6"
                                Height="48"
                                Content="Skapa karta"
                                FontSize="15"
                                Background="Black"
                                Foreground="White"
                                Cursor="Hand"
                                Click="CreateMap_Click"/>


                        <!-- START POINT -->
                        <StackPanel Grid.Row="8">

                            <TextBlock Text="Startpunkt"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>

                            <Border BorderBrush="#C8C8C8"
                                    BorderThickness="1"
                                    Background="White"
                                    CornerRadius="6"
                                    Padding="12">

                                <TextBlock Text="Klicka på en cell i kartan"
                                           FontSize="13"
                                           x:Name="StartPointText"/>

                            </Border>

                        </StackPanel>


                        <!-- GOAL POINT -->
                        <StackPanel Grid.Row="10">

                            <TextBlock Text="Målpunkt"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>

                            <Border BorderBrush="#C8C8C8"
                                    BorderThickness="1"
                                    Background="White"
                                    CornerRadius="6"
                                    Padding="12">

                                <TextBlock Text="Klicka på en cell i kartan"
                                           FontSize="13"
                                           x:Name="EndPointText"/>

                            </Border>

                        </StackPanel>


                        <!-- START VISUALIZATION -->
                        <Button Grid.Row="12"
                                Height="48"
                                Content="Starta visualisering"
                                FontSize="15"
                                Background="Black"
                                Foreground="White"
                                Cursor="Hand"
                                Click="StartVisualization_Click"/>

                    </Grid>

                </Border>

            </Grid>


            <!-- RESULT -->
            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#D0D0D0"
                    BorderThickness="0,1,0,0">

                <Grid Margin="40,20">

                    <TextBlock Text="Resultat"
                               FontSize="24"
                               FontWeight="SemiBold"
                               VerticalAlignment="Top"/>

                    <!-- RESULT TABLE -->
                    <Grid Margin="0,55,200,0">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="55"/>
                            <RowDefinition Height="55"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>


                        <!-- HEADER -->
                        <Border Grid.Row="0"
                                Grid.Column="0"
                                BorderBrush="#D0D0D0"
                                BorderThickness="1"
                                Background="#F2F2F2">

                            <TextBlock Text="Algoritm"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="16,0"/>
                        </Border>

                        <Border Grid.Row="0"
                                Grid.Column="1"
                                BorderBrush="#D0D0D0"
                                BorderThickness="0,1,1,1"
                                Background="#F2F2F2">

                            <TextBlock Text="Kartstorlek"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="16,0"/>
                        </Border>

                        <Border Grid.Row="0"
                                Grid.Column="2"
                                BorderBrush="#D0D0D0"
                                BorderThickness="0,1,1,1"
                                Background="#F2F2F2">

                            <TextBlock Text="Väglängd"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="16,0"/>
                        </Border>

                        <Border Grid.Row="0"
                                Grid.Column="3"
                                BorderBrush="#D0D0D0"
                                BorderThickness="0,1,1,1"
                                Background="#F2F2F2">

                            <TextBlock Text="Besökta noder"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="16,0"/>
                        </Border>

                        <Border Grid.Row="0"
                                Grid.Column="4"
                                BorderBrush="#D0D0D0"
                                BorderThickness="0,1,1,1"
                                Background="#F2F2F2">

                            <TextBlock Text="Körtid"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="16,0"/>
                        </Border>


                        <!-- RESULT -->
                        <Border Grid.Row="1"
                                Grid.Column="0"
                                BorderBrush="#D0D0D0"
                                BorderThickness="1,0,1,1">

                            <!--ALGORITHM TEXT-->
                            <TextBlock
                                x:Name="ResultAlgorithmText"
                                Text="-"
                                VerticalAlignment="Center"
                                Margin="16,0"/>
                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="1"
                                BorderBrush="#D0D0D0"
                                BorderThickness="0,0,1,1">

                            <!--MAP SIZE TEXT-->
                            <TextBlock
                                x:Name="ResultMapSizeText"
                                Text="-"
                                VerticalAlignment="Center"
                                Margin="16,0"/>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Grid.Column="2"
                            BorderBrush="#D0D0D0"
                            BorderThickness="0,0,1,1">

                            <!--PATH LENGTH TEXT-->
                            <TextBlock
                                x:Name="ResultPathLengthText"
                                Text="–"
                                VerticalAlignment="Center"
                                Margin="16,0"/>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Grid.Column="3"
                            BorderBrush="#D0D0D0"
                            BorderThickness="0,0,1,1">

                            <!--VISITED NODES TEXT-->
                            <TextBlock
                                x:Name="ResultVisitedNodesText"
                                Text="–"
                                VerticalAlignment="Center"
                                Margin="16,0"/>
                        </Border>

                        <!--EXECUTION TIME TEXT-->
                        <Border
                            Grid.Row="1"
                            Grid.Column="4"
                            BorderBrush="#D0D0D0"
                            BorderThickness="0,0,1,1">

                            <TextBlock
                                x:Name="ResultExecutionTimeText"
                                Text="–"
                                VerticalAlignment="Center"
                                Margin="16,0"/>
                        </Border>

                    </Grid>
                </Grid>

            </Border>

        </Grid>
    </ScrollViewer>

</Window>
